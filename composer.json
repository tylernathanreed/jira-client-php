{
    "name": "jira/client",
    "description": "Provides an HTTP Client to interact with the Jira Cloud REST API",
    "keywords": [
        "jira",
        "jira-php",
        "jira-cloud",
        "jira-rest"
    ],
    "authors": [
        {
            "name": "Tyler Reed",
            "email": "tylernathanreed@gmail.com"
        }
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "./packages/openapi-client"
        },
        {
            "type": "path",
            "url": "./packages/openapi-generator"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "php-coveralls/php-coveralls": "^2.7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "reedware/openapi-generator": "*",
        "reedware/sail-lite": "^1.0",
        "symfony/var-dumper": "^6.4.4|^7.2"
    },
    "autoload": {
        "psr-4": {
            "Jira\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test:lint": "pint",
        "test:static": "phpstan analyze",
        "test:suite": "XDEBUG_MODE=coverage phpunit",
        "test:coverage": [
            "@test:suite",
            "php-coveralls -v --dry-run"
        ],
        "test": [
            "@test:lint",
            "@test:static",
            "@test:coverage"
        ]
    },
    "suggest": {
        "guzzlehttp/guzzle": "Use guzzle as the underlying HTTP transport (instead of raw cURL)"
    }
}
